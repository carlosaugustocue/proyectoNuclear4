includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    level: 8
    paths:
        - app

    # Excluir stubs de Laravel que PHPStan no puede resolver
    excludePaths:
        - app/Http/Middleware/

    # Permitir llamadas a métodos dinámicos de Eloquent
    checkMissingIterableValueType: false
    checkGenericClassInNonGenericObjectType: false
