# ─── Entorno ──────────────────────────────────────────────────────────────
APP_ENV=local
APP_DEBUG=true
# Generar con: docker compose run --rm api php artisan key:generate --show
APP_KEY=

# ─── Base de datos ────────────────────────────────────────────────────────
DB_DATABASE=nuclear
DB_USERNAME=nuclear
DB_PASSWORD=secret

# ─── Cola (outbox) ────────────────────────────────────────────────────────
# No cambiar: el driver database usa la tabla jobs como outbox (ADR-0003)
QUEUE_CONNECTION=database

# ─── Frontend ─────────────────────────────────────────────────────────────
# URL de la API que usa la PWA en desarrollo
VITE_API_URL=http://localhost:8080/v1
